{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "renderphoenix:plane",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "animations": {
        "states_controller": "controller.animation.renderphoenix.plane_states"
      },
      "scripts": {
        "animate": [
          "states_controller"
        ]
      },
      "properties": {
        "renderphoenix:plane_state": {
          "type": "enum",
          "values": [ "stationary", "takeoff", "flying", "crashing" ],
          "default": "stationary",
          "client_sync": true
        },
        "renderphoenix:trick": {
          "type": "enum",
          "values": [ "ready", "active", "cooldown" ],
          "default": "ready",
          "client_sync": true
        },
        "renderphoenix:plane_angle": {
          "type": "float",
          "range": [ -100.0, 100.0 ],
          "default": 0.0,
          "client_sync": true
        },
        "renderphoenix:wasd": {
          "type": "enum",
          "values": [ "w", "a", "s", "d", "none" ],
          "default": "none",
          "client_sync": true
        }
      }
    },

    "component_groups": {
      "cg:flight_mode": {
        "minecraft:physics": {
          "has_gravity": false,
          "has_collision": true
        }
      },
      "cg:ground_mode": {
        "minecraft:physics": {
          "has_gravity": true,
          "has_collision": true
        }
      }
    },

    "components": {
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:type_family": {
        "family": [ "villager_plane", "daladas", "plane", "vehicle", "inanimate" ]
      },
      "minecraft:collision_box": {
        "width": 3.0,
        "height": 1.2
      },
      "minecraft:custom_hit_test": {
        "hitboxes": [
          { "width": 3.7, "height": 2.0, "pivot": [ 0, 1, 0 ] }
        ]
      },
      "minecraft:health": {
        "value": 150,
        "max": 150
      },
      "minecraft:physics": {
        "has_gravity": true,
        "has_collision": true
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:push_through": {
        "value": 0.9
      },
      "minecraft:horse.jump_strength": {
        "value": 0.0
      },
      "minecraft:can_power_jump": {},
      "minecraft:jump.static": {},
      "minecraft:buoyant": {
        "base_buoyancy": 0.5,
        "apply_gravity": false,
        "drag_down_on_buoyancy_removed": 0,
        "liquid_blocks": [ "water" ]
      },
      "minecraft:behavior.rise_to_liquid_level": {
        "liquid_y_offset": 0.4,
        "rise_delta": 0.2,
        "sink_delta": 0.2
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  { "test": "is_family", "subject": "other", "value": "player" },
                  { "test": "is_riding_self", "subject": "other", "value": true },
                  { "test": "enum_property", "subject": "self", "domain": "renderphoenix:trick", "operator": "==", "value": "ready" },
                  { "test": "enum_property", "subject": "self", "domain": "renderphoenix:plane_state", "operator": "==", "value": "flying" }
                ]
              },
              "event": "renderphoenix:trigger_trick",
              "target": "self"
            },
            "deals_damage": false
          },
          { "cause": "fall", "deals_damage": false },
          { "cause": "suffocation", "deals_damage": false }
        ]
      },
      "minecraft:nameable": {
        "allow_name_tag_renaming": true,
        "always_show": false
      },
      "minecraft:rideable": {
        "seat_count": 1,
        "family_types": [ "player", "villager" ],
        "interact_text": "action.interact.ride.plane",
        "controlling_seat": 0,
        "crouching_skip_interact": true,
        "pull_in_entities": true,
        "rider_can_interact": true,
        "seats": [
          {
            "position": [ 0, 0.3, 5 ],
            "min_rider_count": 0,
            "max_rider_count": 1,
            "third_person_camera_radius": 8.0,
            "camera_relax_distance_smoothing": 1.0
          }
        ]
      },
      "minecraft:interact": {
        "interactions": [
          {
            "interact_text": "action.interact.board_villager",
            "on_interact": {
              "filters": {
                "all_of": [
                  { "test": "has_equipment", "subject": "other", "domain": "hand", "value": "emerald" },
                  { "test": "has_rider", "subject": "self", "value": false }
                ]
              },
              "event": "renderphoenix:board_nearby_villager"
            }
          }
        ]
      }
    },

    "events": {
      "minecraft:entity_spawned": {
        "add": { "component_groups": [ "cg:ground_mode" ] },
        "set_property": {
          "renderphoenix:plane_state": "stationary",
          "renderphoenix:trick": "ready",
          "renderphoenix:wasd": "none"
        }
      },

      "renderphoenix:enter_flight_mode": {
        "add": { "component_groups": [ "cg:flight_mode" ] },
        "remove": { "component_groups": [ "cg:ground_mode" ] }
      },

      "renderphoenix:enter_ground_mode": {
        "add": { "component_groups": [ "cg:ground_mode" ] },
        "remove": { "component_groups": [ "cg:flight_mode" ] }
      },

      "renderphoenix:trigger_trick": {
        "set_property": { "renderphoenix:trick": "active" }
      },

      "renderphoenix:board_nearby_villager": {
        "queue_command": {
          "command": [
            "ride @e[type=villager,c=1,r=6] start_riding @s teleport_rider",
            "playsound random.pop @a ~ ~ ~ 1 1"
          ]
        }
      }
    }
  }
}