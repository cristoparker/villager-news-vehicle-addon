{
  "format_version": "1.20.80",
  "minecraft:entity": {
    "description": {
      "identifier": "renderphoenix:tank",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "animations": {
        "pilot_controller": "controller.animation.tank.pilot"
      },
      "scripts": {
        "animate": [
          "pilot_controller"
        ]
      }
    },
    "component_groups": {
      "renderphoenix:tank_wander": {
        "minecraft:movement": {
          "value": 0.3
        },
        "minecraft:behavior.random_stroll": {
          "priority": 6,
          "speed_multiplier": 1.0
        },
        "minecraft:behavior.look_at_player": {
          "priority": 7,
          "look_distance": 12.0,
          "probability": 0.02
        },
        "minecraft:behavior.random_look_around": {
          "priority": 8
        }
      },
      "renderphoenix:tank_player_pilot": {
        "minecraft:input_ground_controlled": {},
        "minecraft:movement": {
          "value": 0.42
        }
      }
    },
    "components": {
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:type_family": {
        "family": [
          "villager_tank",
          "tank",
          "inanimate",
          "vehicle"
        ]
      },
      "minecraft:collision_box": {
        "width": 5.0,
        "height": 4.0
      },
      "minecraft:custom_hit_test": {
        "hitboxes": [
          {
            "width": 5.0,
            "height": 4.0,
            "pivot": [
              0,
              2.0,
              0.2
            ]
          }
        ]
      },
      "minecraft:health": {
        "value": 200,
        "max": 200
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "on_damage": {
              "filters": {
                "all_of": [
                  {
                    "test": "is_family",
                    "subject": "other",
                    "value": "player"
                  },
                  {
                    "test": "is_riding_self",
                    "subject": "other",
                    "value": true
                  }
                ]
              },
              "event": "renderphoenix:shoot_missile"
            },
            "deals_damage": false
          },
          {
            "cause": "fall",
            "deals_damage": false
          },
          {
            "cause": "drowning",
            "deals_damage": false
          },
          {
            "cause": "suffocation",
            "deals_damage": false
          }
        ]
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      "minecraft:physics": {
        "has_gravity": true,
        "has_collision": true
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:movement.basic": {},
      "minecraft:navigation.walk": {
        "can_path_over_water": true,
        "avoid_water": true,
        "can_pass_doors": true,
        "can_open_doors": false
      },
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:step_height": {
        "value": 1.06
      },
      "minecraft:lookat": {
        "search_radius": 14.0,
        "set_target": true,
        "look_cooldown": 2.0
      },
      "minecraft:rideable": {
        "seat_count": 1,
        "family_types": [
          "player",
          "villager"
        ],
        "interact_text": "action.interact.ride.tank",
        "controlling_seat": 0,
        "seats": [
          {
            "position": [
              0,
              3.7,
              3.3
            ],
            "min_rider_count": 0,
            "max_rider_count": 1
          }
        ]
      }
    },
    "events": {
      "renderphoenix:shoot_missile": {
        "queue_command": {
          "command": [
            "playsound random.bow @a ~ ~ ~ 1.5 0.5",
            "playsound random.explode @a ~ ~ ~ 0.8 1.8",
            "particle minecraft:basic_smoke_particle ^ ^ ^3"
          ]
        }
      },
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "renderphoenix:tank_wander"
          ]
        }
      },
      "renderphoenix:on_player_mount": {
        "remove": {
          "component_groups": [
            "renderphoenix:tank_wander"
          ]
        },
        "add": {
          "component_groups": [
            "renderphoenix:tank_player_pilot"
          ]
        }
      },
      "renderphoenix:on_wander": {
        "remove": {
          "component_groups": [
            "renderphoenix:tank_player_pilot"
          ]
        },
        "add": {
          "component_groups": [
            "renderphoenix:tank_wander"
          ]
        }
      }
    }
  }
}