{
  "format_version": "1.20.80",
  "minecraft:entity": {
    "description": {
      "identifier": "renderphoenix:helicopter",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "animations": {
        "flight_controller": "controller.animation.villager_helicopter.flight"
      },
      "scripts": {
        "animate": [
          "flight_controller"
        ]
      },
      "properties": {
        "renderphoenix:heli_pitch": {
          "type": "float",
          "range": [
            -45.0,
            45.0
          ],
          "default": 0.0,
          "client_sync": true
        },
        "renderphoenix:heli_roll": {
          "type": "float",
          "range": [
            -45.0,
            45.0
          ],
          "default": 0.0,
          "client_sync": true
        },
        "renderphoenix:heli_flying": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "renderphoenix:wasd": {
          "type": "enum",
          "values": [
            "w",
            "a",
            "s",
            "d",
            "none"
          ],
          "default": "none",
          "client_sync": true
        }
      }
    },
    "component_groups": {
      "renderphoenix:grounded": {
        "minecraft:physics": {
          "has_gravity": true,
          "has_collision": true
        }
      },
      "renderphoenix:player_flight": {
        "minecraft:physics": {
          "has_gravity": false,
          "has_collision": true
        }
      },
      "renderphoenix:villager_flight": {
        "minecraft:type_family": {
          "family": [
            "villager_helicopter",
            "inanimate",
            "vehicle",
            "helicopter_flying",
            "villager_piloted"
          ]
        },
        "minecraft:physics": {
          "has_gravity": false,
          "has_collision": true
        },
        "minecraft:can_fly": {},
        "minecraft:movement.hover": {
          "max_turn": 25.0
        },
        "minecraft:navigation.fly": {
          "can_path_over_water": true
        },
        "minecraft:movement": {
          "value": 0.45
        },
        "minecraft:behavior.random_fly": {
          "priority": 1,
          "xz_dist": 25,
          "y_dist": 10,
          "speed_multiplier": 1.0,
          "can_land_on_trees": false
        },
        "minecraft:behavior.random_look_around": {
          "priority": 2
        }
      }
    },
    "components": {
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:type_family": {
        "family": [
          "villager_helicopter",
          "inanimate",
          "vehicle"
        ]
      },
      "minecraft:collision_box": {
        "width": 3.4,
        "height": 4.0
      },
      "minecraft:custom_hit_test": {
        "hitboxes": [
          {
            "width": 3.4,
            "height": 4,
            "pivot": [
              0,
              2,
              -0.6
            ]
          }
        ]
      },
      "minecraft:health": {
        "value": 100,
        "max": 100
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": false
          },
          {
            "cause": "suffocation",
            "deals_damage": false
          }
        ]
      },
      "minecraft:horse.jump_strength": {
        "value": 0.0
      },
      "minecraft:can_power_jump": {},
      "minecraft:jump.static": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:nameable": {
        "allow_name_tag_renaming": true,
        "always_show": false
      },
      "minecraft:rideable": {
        "seat_count": 1,
        "family_types": [
          "player",
          "villager"
        ],
        "interact_text": "action.interact.ride.helicopter",
        "controlling_seat": 0,
        "crouching_skip_interact": true,
        "pull_in_entities": true,
        "rider_can_interact": true,
        "seats": [
          {
            "position": [
              0,
              0.5,
              -0.6
            ],
            "min_rider_count": 0,
            "max_rider_count": 1
          }
        ]
      },
      "minecraft:interact": {
        "interactions": [
          {
            "interact_text": "action.interact.board_villager",
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "has_equipment",
                    "subject": "other",
                    "domain": "hand",
                    "value": "emerald"
                  },
                  {
                    "test": "has_rider",
                    "subject": "self",
                    "value": false
                  }
                ]
              },
              "event": "renderphoenix:board_nearby_villager"
            }
          }
        ]
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "renderphoenix:grounded"
          ]
        },
        "set_property": {
          "renderphoenix:heli_pitch": 0.0,
          "renderphoenix:heli_roll": 0.0,
          "renderphoenix:heli_flying": false
        }
      },
      "renderphoenix:enter_flight_mode": {
        "remove": {
          "component_groups": [
            "renderphoenix:grounded",
            "renderphoenix:villager_flight"
          ]
        },
        "add": {
          "component_groups": [
            "renderphoenix:player_flight"
          ]
        },
        "set_property": {
          "renderphoenix:heli_flying": true
        }
      },
      "renderphoenix:enter_ground_mode": {
        "remove": {
          "component_groups": [
            "renderphoenix:player_flight",
            "renderphoenix:villager_flight"
          ]
        },
        "add": {
          "component_groups": [
            "renderphoenix:grounded"
          ]
        },
        "set_property": {
          "renderphoenix:heli_flying": false,
          "renderphoenix:heli_pitch": 0.0,
          "renderphoenix:heli_roll": 0.0
        }
      },
      "renderphoenix:villager_mount": {
        "run_command": {
          "command": [
            "/ride @e[type=villager,r=3.5,c=1] start_riding @s"
          ]
        },
        "remove": {
          "component_groups": [
            "renderphoenix:grounded",
            "renderphoenix:player_flight"
          ]
        },
        "add": {
          "component_groups": [
            "renderphoenix:villager_flight"
          ]
        },
        "set_property": {
          "renderphoenix:heli_flying": true
        }
      },
      "renderphoenix:on_dismount": {
        "remove": {
          "component_groups": [
            "renderphoenix:player_flight",
            "renderphoenix:villager_flight"
          ]
        },
        "add": {
          "component_groups": [
            "renderphoenix:grounded"
          ]
        },
        "set_property": {
          "renderphoenix:heli_flying": false,
          "renderphoenix:heli_pitch": 0.0,
          "renderphoenix:heli_roll": 0.0
        }
      },
      "renderphoenix:board_nearby_villager": {
        "run_command": {
          "command": [
            "/ride @e[type=villager,r=6,c=1] start_riding @s",
            "playsound random.pop @a ~ ~ ~ 1 1"
          ]
        },
        "trigger": "renderphoenix:villager_mount"
      }
    }
  }
}