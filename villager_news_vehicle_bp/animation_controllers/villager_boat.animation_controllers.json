{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.villager_boat.pilot": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "on_entry": [
            "@s renderphoenix:boat_on_dismount"
          ],
          "transitions": [
            {
              "piloted": "query.has_rider"
            }
          ]
        },
        "piloted": {
          "on_entry": [
            "@s renderphoenix:boat_player_mount"
          ],
          "transitions": [
            {
              "idle": "!query.has_rider"
            }
          ]
        }
      }
    }
  }
}
