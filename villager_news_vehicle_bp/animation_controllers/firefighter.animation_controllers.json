{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.firefighter.pilot": {
      "initial_state": "wander",
      "states": {
        "wander": {
          "on_entry": [
            "@s renderphoenix:on_wander"
          ],
          "transitions": [
            {
              "piloted": "query.has_rider"
            }
          ]
        },
        "piloted": {
          "on_entry": [
            "@s renderphoenix:on_player_mount"
          ],
          "transitions": [
            {
              "wander": "!query.has_rider"
            }
          ]
        }
      }
    }
  }
}
