{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.villager_helicopter.flight": {
      "initial_state": "grounded",
      "states": {
        "grounded": {
          "on_entry": [
            "@s renderphoenix:enter_ground_mode"
          ],
          "transitions": [
            {
              "flying": "query.property('renderphoenix:heli_flying')"
            }
          ]
        },
        "flying": {
          "on_entry": [
            "@s renderphoenix:enter_flight_mode"
          ],
          "transitions": [
            {
              "grounded": "!query.property('renderphoenix:heli_flying')"
            }
          ]
        }
      }
    }
  }
}
