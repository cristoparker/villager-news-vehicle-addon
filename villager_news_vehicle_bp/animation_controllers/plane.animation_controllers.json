{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.renderphoenix.plane_states": {
      "initial_state": "stationary",
      "states": {
        "stationary": {
          "transitions": [
            {
              "takeoff": "query.property('renderphoenix:plane_state') == 'takeoff'"
            },
            {
              "flying": "query.property('renderphoenix:plane_state') == 'flying'"
            }
          ]
        },
        "takeoff": {
          "transitions": [
            {
              "flying": "query.property('renderphoenix:plane_state') == 'flying'"
            },
            {
              "stationary": "query.property('renderphoenix:plane_state') == 'stationary'"
            }
          ]
        },
        "flying": {
          "transitions": [
            {
              "takeoff": "query.property('renderphoenix:plane_state') == 'takeoff'"
            },
            {
              "stationary": "query.property('renderphoenix:plane_state') == 'stationary'"
            }
          ]
        }
      }
    }
  }
}
