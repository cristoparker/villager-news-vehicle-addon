{
  "format_version": "1.20.80",
  "minecraft:entity": {
    "description": {
      "identifier": "villager_news:helicopter",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "animations": {
        "flight_controller": "controller.animation.villager_helicopter.flight"
      },
      "scripts": {
        "animate": [
          "flight_controller"
        ]
      }
    },
    "component_groups": {
      "villager_news:grounded": {
        "minecraft:physics": {
          "has_gravity": true,
          "has_collision": true
        },
        "minecraft:movement": {
          "value": 0.0
        }
      },
      "villager_news:player_flight": {
        "minecraft:type_family": {
          "family": [
            "villager_helicopter",
            "inanimate",
            "vehicle",
            "helicopter_flying",
            "player_piloted"
          ]
        },
        "minecraft:physics": {
          "has_gravity": false,
          "has_collision": true
        },
        "minecraft:can_fly": {},
        "minecraft:movement.hover": {
          "max_turn": 30.0
        },
        "minecraft:navigation.fly": {
          "can_path_over_water": true
        },
        "minecraft:movement": {
          "value": 0.6
        },
        "minecraft:input_air_controlled": {
          "strafe_speed_modifier": 1.0,
          "backwards_movement_modifier": 0.5
        },
        "minecraft:vertical_movement_action": {
          "vertical_velocity": 0.5
        }
      },
      "villager_news:villager_flight": {
        "minecraft:type_family": {
          "family": [
            "villager_helicopter",
            "inanimate",
            "vehicle",
            "helicopter_flying",
            "villager_piloted"
          ]
        },
        "minecraft:physics": {
          "has_gravity": false,
          "has_collision": true
        },
        "minecraft:can_fly": {},
        "minecraft:movement.hover": {
          "max_turn": 25.0
        },
        "minecraft:navigation.fly": {
          "can_path_over_water": true
        },
        "minecraft:movement": {
          "value": 0.4
        },
        "minecraft:behavior.random_fly": {
          "priority": 1,
          "xz_dist": 20,
          "y_dist": 8,
          "speed_multiplier": 1.0,
          "can_land_on_trees": false
        },
        "minecraft:behavior.random_look_around": {
          "priority": 2
        }
      }
    },
    "components": {
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:type_family": {
        "family": [
          "villager_helicopter",
          "inanimate",
          "vehicle"
        ]
      },
      "minecraft:collision_box": {
        "width": 3.1,
        "height": 3.8
      },
      "minecraft:custom_hit_test": {
        "hitboxes": [
          {
            "width": 3.1,
            "height": 3.8,
            "pivot": [0, 1.9, -0.6]
          }
        ]
      },
      "minecraft:health": {
        "value": 100,
        "max": 100
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": false
          },
          {
            "cause": "suffocation",
            "deals_damage": false
          }
        ]
      },
      "minecraft:knockback_resistance": {
        "value": 1.0
      },
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:nameable": {
        "allow_name_tag_renaming": true,
        "always_show": false
      },
      "minecraft:rideable": {
        "seat_count": 1,
        "family_types": [
          "player",
          "villager"
        ],
        "interact_text": "action.interact.ride.boat",
        "controlling_seat": 0,
        "seats": [
          {
            "position": [0, 0.5, -0.6],
            "min_rider_count": 0,
            "max_rider_count": 1
          }
        ]
      },
      "minecraft:interact": {
        "interactions": [
          {
            "interact_text": "action.interact.ride.boat",
            "on_interact": {
              "filters": {
                "test": "is_family",
                "subject": "other",
                "value": "player"
              },
              "event": "villager_news:player_mount"
            }
          },
          {
            "interact_text": "action.interact.board_villager",
            "on_interact": {
              "filters": {
                "all_of": [
                  {
                    "test": "has_equipment",
                    "subject": "other",
                    "domain": "hand",
                    "value": "emerald"
                  },
                  {
                    "test": "has_rider",
                    "subject": "self",
                    "value": false
                  }
                ]
              },
              "event": "villager_news:board_nearby_villager"
            }
          }
        ]
      },
      "minecraft:entity_sensor": {
        "sensor_range": 2.5,
        "relative_range": false,
        "event_filters": {
          "all_of": [
            {
              "test": "has_rider",
              "subject": "self",
              "value": false
            },
            {
              "test": "is_family",
              "subject": "other",
              "value": "villager"
            }
          ]
        },
        "event": "villager_news:villager_mount"
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "villager_news:grounded"
          ]
        }
      },
      "villager_news:player_mount": {
        "remove": {
          "component_groups": [
            "villager_news:grounded",
            "villager_news:villager_flight"
          ]
        },
        "add": {
          "component_groups": [
            "villager_news:player_flight"
          ]
        }
      },
      "villager_news:villager_mount": {
        "run_command": {
          "command": [
            "/ride @e[type=villager,r=3,c=1] start_riding @s"
          ]
        },
        "remove": {
          "component_groups": [
            "villager_news:grounded",
            "villager_news:player_flight"
          ]
        },
        "add": {
          "component_groups": [
            "villager_news:villager_flight"
          ]
        }
      },
      "villager_news:board_nearby_villager": {
        "run_command": {
          "command": [
            "/ride @e[type=villager,r=6,c=1] start_riding @s"
          ]
        },
        "remove": {
          "component_groups": [
            "villager_news:grounded",
            "villager_news:player_flight"
          ]
        },
        "add": {
          "component_groups": [
            "villager_news:villager_flight"
          ]
        }
      },
      "villager_news:on_dismount": {
        "remove": {
          "component_groups": [
            "villager_news:player_flight",
            "villager_news:villager_flight"
          ]
        },
        "add": {
          "component_groups": [
            "villager_news:grounded"
          ]
        }
      }
    }
  }
}
