{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "renderphoenix:helicopter",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/entity/villager_helicopter/farmer"
      },
      "geometry": {
        "default": "geometry.renderphoenix.helicopter"
      },
      "animations": {
        "propeller_controller": "controller.animation.villager_helicopter.propellers",
        "propellers": "animation.villager_helicopter.propellers",
        "propellers_standby": "animation.villager_helicopter.propellers_standby",
        "tilt": "animation.villager_helicopter.tilt",
        "sound_controller": "controller.animation.villager_helicopter.sound",
        "engine_sound": "animation.villager_helicopter.engine_sound",
        "engine_sound.standby": "animation.villager_helicopter.engine_sound.standby"
      },
      "scripts": {
        "should_update_bones_and_effects_offscreen": true,
        "animate": [
          "propeller_controller",
          "tilt",
          "sound_controller"
        ],
        "initialize": [
          "v.pitch_tilt = 0;",
          "v.roll_tilt = 0;"
        ],
        "pre_animation": [
          "v.pitch_tilt = query.property('renderphoenix:heli_pitch');",
          "v.roll_tilt = query.property('renderphoenix:heli_roll');"
        ]
      },
      "sound_effects": {
        "rotor": "renderphoenix.vehicle.helicopter.rotor",
        "rotor.standby": "renderphoenix.vehicle.helicopter.standby"
      },
      "render_controllers": [
        "controller.render.villager_helicopter"
      ],
      "spawn_egg": {
        "base_color": "#633c1d",
        "overlay_color": "#4a8522"
      }
    }
  }
}
