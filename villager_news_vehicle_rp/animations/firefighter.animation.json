{
  "format_version": "1.10.0",
  "animations": {
    "animation.firefighter.wheels": {
      "loop": true,
      "anim_time_update": "query.anim_time + query.delta_time",
      "bones": {
        "wheel1": {
          "rotation": ["v.wheel_rot", "v.steer_angle", 0]
        },
        "wheel3": {
          "rotation": ["v.wheel_rot", "v.steer_angle", 0]
        },
        "wheel2": {
          "rotation": ["v.wheel_rot", 0, 0]
        },
        "wheel4": {
          "rotation": ["v.wheel_rot", 0, 0]
        }
      }
    },
    "animation.firefighter.look_at_target": {
      "loop": true,
      "bones": {
        "head": {
          "rotation": ["query.target_x_rotation", "query.target_y_rotation", 0]
        }
      }
    }
  }
}
